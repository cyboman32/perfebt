{
  "Name": "PerfeBT",
  "Enabled": true,
  "Version": "0.9.1",
  "Author": "local",
  "Description": "Performance fixes for BattleTech with RogueTech, plus optional performance monitoring (profiler, hitch log, per-segment reports in Mods/PerfeBT/reports). Optimizations=false turns every fix off; PerformanceMonitoring=true turns the diagnostics on (Ctrl+Shift+P writes a report on demand).",
  "DLL": "PerfeBT.dll",
  "DLLEntryPoint": "PerfeBT.Main.Init",
  "Settings": {
    "Optimizations": true,
    "PerformanceMonitoring": false,
    "Profile": true,
    "FixTagSetIndex": true,
    "SkipInternetCheck": true,
    "TimeLocalSettingsReads": true,
    "TimeAutoFixers": true,
    "DelayedCallCensus": true,
    "FindObjectWatch": true,
    "VisibilityWatch": true,
    "LoopTimerSeconds": 30,
    "LoopTimerTopN": 10,
    "InstrumentHarmonyPatches": true,
    "TypePatterns": [
      "^BattleTech\\.Data\\.DataManager(\\+|$)",
      "^BattleTech\\.Data\\.LoadRequest$",
      "^BattleTech\\.Save\\.",
      "^BattleTech\\.Serialization\\.Serializer$"
    ],
    "AssemblyPatterns": [],
    "InstrumentSafeCctorTypes": false,
    "ExcludePatterns": [
      "::(get|set)_",
      "::(op_|Equals$|GetHashCode$|ToString$)"
    ],
    "MinIlBytes": 24,
    "MinPatchIlBytes": 8,
    "HitchMs": 150,
    "AutoSegmentCalmSeconds": 4,
    "AutoSegmentMinBusyMs": 1000,
    "TopN": 60,
    "HitchTopN": 12,
    "RescanDelaySeconds": 20,
    "FixUnitTypeTags": true,
    "FixCategoryCache": true,
    "SaveLoadMaxLightLoads": 300,
    "LoadFrameBudgetMs": 1000,
    "FixDataLoaderMonitoring": true,
    "SaveLoadMaxHeavyLoads": 0,
    "LoadDiagnostics": true,
    "FixJsonReflection": true,
    "LateTypePatternsOff": [
      "^Assembly-CSharp:HBS\\.Util\\.JSONSerializationUtility$",
      "^Assembly-CSharp:fastJSON\\.JSON$",
      "^Assembly-CSharp:HBS\\.Data\\.DataLoader$",
      "^Assembly-CSharp:BattleTech\\.Data\\.DataManager(\\+\\w+)?$",
      "^Assembly-CSharp:BattleTech\\.Data\\.LoadRequest$",
      "^Assembly-CSharp:BattleTech\\.(MechDef|ChassisDef|VehicleDef|VehicleChassisDef|StarSystemDef)$",
      "^Assembly-CSharp:HBS\\.Reflection\\.ReflectionCache$",
      "^Assembly-CSharp:HBS\\.Reflection\\.MemberInfoHelper$",
      "^Assembly-CSharp:BattleTech\\.BattleTechResourceLocator$"
    ],
    "LateTypePatterns": [
      "^CustomComponents:CustomComponents\\.(DefaultFixer|DefaultsDatabase|InventoryOperationState|DefaultHelper|Changes\\.\\w+)(\\+\\w+)?$",
      "^Assembly-CSharp:BattleTech\\.(SimGameState|Shop|StarSystem|CombatGameState|GameInstance|UnityGameInstance|LevelLoader|Contract|LanceSpawnerGameLogic|UnitSpawnPointGameLogic)$",
      "^Assembly-CSharp:BattleTech\\.UI\\.(SG_Shop\\w*|MechLab\\w*|MechBay\\w*|LanceConfigurator\\w*|AAR_\\w+|SGContractsWidget|SGNavigation\\w*|SG_HiringHall\\w*|SGBarracks\\w*|InventoryItemElement\\w*|ListElementController\\w*|InventoryDataObject\\w*|SimGameOptionsMenu|SGRoomManager|SGRoomController_\\w+|UIModule|UIManager)$",
      "^UnityEngine.UI:UnityEngine\\.UI\\.(CanvasUpdateRegistry|LayoutRebuilder|Graphic|MaskableGraphic|Image|LayoutGroup|HorizontalOrVerticalLayoutGroup|GridLayoutGroup|ScrollRect|Selectable|Mask|RectMask2D|ContentSizeFitter)$",
      "^Assembly-CSharp:BattleTech\\.(Data\\.PrefabCache|Assetbundles\\.AssetBundleManager|MechRepresentationSimGame|MechRepresentation|PilotableActorRepresentation|GameRepresentation|ComponentRepresentation|WeaponRepresentation|Rendering\\.PropertyBlockManager|Rendering\\.MechCustomization\\.\\w+|UI\\.MechPaintPatternSelectorWidget|UI\\.SGRoomController_MechBay)$",
      "^Unity.TextMeshPro:TMPro\\.(TextMeshProUGUI|TMP_Text|TMP_UpdateRegistry|TMP_SubMeshUI)$"
    ],
    "InitTypePatterns": [
      "^ModTek:ModTek\\.Features\\.Manifest\\.(?!Patches\\.)[\\w.]+(\\+\\w+)?$"
    ],
    "FixDefaultsChangeFast": true,
    "FixInventorySortFast": true,
    "FixPendingAdjustScan": true,
    "FixPrefabBundleScan": true,
    "FixMechLabIconPreload": true,
    "FixContractIntelMinimap": true,
    "PreloadIrbtPortraits": true,
    "VerifyPrefabBundleScan": false,
    "FixSqliteInList": true,
    "HeapCensus": true,
    "HeapCensusHotkey": "ctrl+shift+H",
    "HeapCensusScenes": [],
    "HeapCensusSceneDelaySeconds": 30,
    "LoadGcPause_Comment": "Garbage collector timing; see README 'Memory and garbage collection'. Each collection freezes the game 1-5 s. LoadGcPause=false restores the game's normal behaviour. GcBudgetMb: extra MB the game may use before a collection (0 = normal collections in play). GcMinFreeMemoryMb: collect early when free RAM or page file drops below this.",
    "LoadGcPause": true,
    "GcBudgetMb": 14000,
    "GcLoadCollectMinMb": 2000,
    "GcPauseMaxGrowthMb": 12000,
    "GcMinFreeMemoryMb": 3000,
    "UnloadDiagnostics": true,
    "UnloadSkipSites": [
      "CustomMaps.LoadCustom#1",
      "CustomMaps.LoadCustom#2",
      "LevelLoader.Load#1",
      "LevelLoader.Load#2"
    ],
    "UnloadCoalesceFrames": 30,
    "UnloadDeferSites": [
      "DataManager.Clear"
    ],
    "UnloadDeferFrames": 3,
    "EmptySceneAdditive": true,
    "TransitionWatch": false,
    "TransitionWatchShotSeconds": 1,
    "LoadingScreenFix": true,
    "SaveProfile": true,
    "ReleaseCombatLeftovers": true,
    "QuitWatch": true,
    "ExitFast": true,
    "LayoutFastPath": true,
    "SaveAlloc": true,
    "UiListPoolTrim": true,
    "DelayedStartIndex": false,
    "DelayedStartIndexVerifyEvery": 64,
    "FindObjectMissCache": true,
    "FindObjectMissCacheVerifyEvery": 64,
    "VisibilityRebuildMemo": true,
    "VisibilityRebuildMemoVerifyEvery": 64,
    "LineOfSightRayMemo": true,
    "LineOfSightRayMemoVerifyEvery": 64,
    "LineOfSightRayMemoPersist": true,
    "LineOfSightFastTrace": true,
    "LineOfSightFastTraceVerifyEvery": 64,
    "LineOfFireRayMemo": true,
    "LineOfFireRayMemoVerifyEvery": 64,
    "LowVisibilityLineOfFire": true,
    "LowVisibilityLineOfFireVerifyEvery": 64,
    "GcStatsLog": true,
    "GcDumpAfterUsedMb": 0,
    "ProfileAlloc": true,
    "AllocWindowSeconds": 60,
    "AllocWindowTopN": 8
  }
}